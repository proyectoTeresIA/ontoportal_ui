%div.hide-if-loading.ontolex_details_component
  %div.card
    = header
  %div.my-3
  %div.raw-table
    = render DropdownContainerComponent.new(title: 'All Properties', id: "accordion-#{@id}", is_open: true) do
      = render TableComponent.new(stripped: true) do |t|
        - if @bottom_keys.present?
          - top_set, leftover_set, bottom_set = filter_properties(@top_keys, @bottom_keys, @exclude_keys, @entity_data)

          - sections.each do |section|
            - t.row do
              = section

          - row_hash_properties(top_set).each do |row|
            - t.add_row(*row)

          - row_hash_properties(leftover_set).each do |row|
            - t.add_row(*row)

          - row_hash_properties(bottom_set).each do |row|
            - t.add_row(*row)
