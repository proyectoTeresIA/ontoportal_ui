%div{class: 'modal-header'}
  %h5{class: 'modal-title', id: 'changeRequestModalLabel'}
    = t('change_requests.remove_synonym.title', concept_label: @concept_label)
  %button{type: 'button', class: 'btn-close', 'data-bs-dismiss': 'modal', 'aria-label': t('shared.close')}
= form_with scope: :remove_synonym, url: change_requests_path, local: false do |f|
  = hidden_field_tag 'concept_id', @concept_id
  = hidden_field_tag 'concept_label', @concept_label
  = hidden_field_tag 'github_id', @user.githubId
  = hidden_field_tag 'ont_acronym', @ont_acronym
  = hidden_field_tag 'orcid_id', @user.orcidId
  = hidden_field_tag 'username', @user.username
  = hidden_field_tag 'operation', KGCL::Operations::REMOVE_SYNONYM
  %div{class: 'modal-body'}
    %div.mb-3
      %label{for: 'remove_synonym_synonym', class: 'form-label'}= t('change_requests.remove_synonym.labels.synonym')
      = f.select :synonym, options_for_select(@concept_synonyms, 0), {}, { class: 'form-select' }
    %div.mb-3
      = f.label :comment, t('change_requests.remove_synonym.labels.comment'), class: 'form-label'
      = f.text_area :comment, rows: 5, class: 'form-control'
  %div{class: 'modal-footer'}
    %button{type: 'button', class: 'btn btn-secondary', 'data-bs-dismiss': 'modal'}= t('change_requests.remove_synonym.close')
    = submit_tag t('change_requests.remove_synonym.submit'), id: 'remove_synonym_button', class: 'btn btn-primary'
