- @title = t('notifier.feedback.feedback')
- if params[:pop].eql?("true")
  - pop = true
%div{:style => "margin:20px;"}
  = form_tag('/feedback') do
    -# Simulate form_for by providing a hidden field to check for submission
    = hidden_field_tag 'sim_submit', 'true'
    %p{:style => "font-size:14px"}= t('feedback.form.support_intro')
    %p= t('feedback.form.please_include')
    .feedback
      %ul
        %li= t('feedback.form.include_email')
        %li
          = t('feedback.form.include_error_details')
          %ul
            %li= t('feedback.form.error_url')
            %li= t('feedback.form.error_steps')
            %li= t('feedback.form.error_message')
    %p
      = t('feedback.form.email_us_intro')
      %a{:href => "mailto:#{$SUPPORT_EMAIL}"}= $SUPPORT_EMAIL
    - unless @errors.nil?
      %div{:style => "color:red;margin-bottom:1em;"}
        = t('feedback.form.errors_on_form')
        %ul
          - for error in @errors
            %li= error
    %table.form
      = hidden_field_tag("pop", pop)
      = hidden_field_tag("location", params[:location])
      - if session[:user].nil?
        %tr
          %th.top= t('feedback.form.name_label')
          %td.top
            %input{:name => "name", :style => "width:180px", :type => "text", :value => "#{h(params[:name])}"}/
        %tr
          %th= t('feedback.form.email_label')
          %td
            %input{:name => "email", :style => "width:180px", :type => "text", :value => "#{h(params[:email])}"}/
      - else
        = t('feedback.form.hello')
        = succeed "," do
          %b= session[:user].username
        = hidden_field_tag "name", session[:user].username
        = hidden_field_tag "email", session[:user].email
      %tr
        %th.top= t('feedback.form.comment_label')
        %td.top
          %textarea{:cols => "60", :name => "comment", :rows => "8"}= h(params[:comment])
      - if using_captcha? && !session[:user]
        %tr
          %th
          %td= recaptcha_tags
      %tr
        %td{:align => "right", :colspan => "2"}
          %input{:type => "submit", :value => t('feedback.form.send_button')}/
