%div#bd_container{style: "padding: 2em;"}
  %h1= t('home.validate_ontology_file.heading')

  %div#validate_form{style: "margin-top: 1em;"}
    =form_tag({:action => 'validate_ontology_file'}, :multipart => true) do
      %input{type: "file", name: "ontology_file"}
      %input{type: "submit", value: t('home.validate_ontology_file.validate_button')}