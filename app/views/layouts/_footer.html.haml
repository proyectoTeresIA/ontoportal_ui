          %div.col-auto
            = image_tag('logos/prtr.jpg', style: 'max-height: 3rem;')
          %div.col-auto
            = image_tag('logos/financiado-eu.jpg', style: 'max-height: 3rem;')
        %div.row.legal-text
          %div.col
            = t('.grant_html')
        %div.row.pt-1.legal-text
          %div.col
            %div.d-flex.flex-wrap.align-items-center.gap-2
