%div.password-reset
  = form_with scope: :user , url: login_send_pass_path do |f|
    %h3= t('login.lost_password.title')
    %p.text-muted.mb-5
      = t('login.lost_password.instructions', site: $SITE)
    %div.mb-3
      = f.label :email, t('login.lost_password.email'), class: 'form-label'
      = f.email_field :email, class: 'form-control'
    %div.mb-3
      = f.label :account_name, t('login.lost_password.username'), class: 'form-label'
      = f.text_field :account_name, class: 'form-control'
    %div
      = submit_tag t('login.lost_password.reset_button'), class: 'btn btn-primary'
