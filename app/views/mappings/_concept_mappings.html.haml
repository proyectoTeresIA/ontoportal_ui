= turbo_frame_tag 'mapping_count' do
  = @mappings.size

= turbo_frame_tag @type.eql?('modal') ? 'application_modal_content' : 'concept_mappings' do
  %div.p-1
    - if @ontolex_mappings
      - if @mappings.empty?
        %p.text-muted= t('mappings.table.none_for_class')
      - else
        %table.table.table-sm#concept_mappings_table
          %thead
            %tr
              %th= t('mappings.table.headers.mapping_to')
              %th= t('mappings.table.headers.ontology')
              %th= t('mappings.ontolex.relation_type')
          %tbody
            - @mappings.each do |map|
              - target = map.classes&.last
              - target_id = target&.id.to_s
              - target_label = target&.prefLabel || target_id.split(/[#\/]/).last
              - target_ont_link = target&.links&.dig('ontology') || ''
              - target_acr = target_ont_link.split('/').last
              %tr
                %td
                  - if target_id.start_with?('http')
                    = link_to target_label, ontology_path(target_acr, p: 'lexical_concepts', id: target_id), data: { turbo: false }
                  - else
                    = target_label
                %td
                  - if target_acr.present?
                    = link_to target_acr, ontology_path(target_acr)
                  - else
                    = t('mappings.ontolex.unknown_ontology')
                %td
                  %span.badge.bg-secondary= map.source
    - else
      - if session[:user].nil?
        = link_to t('mappings.create_new_mapping'), "/login?redirect=/ontologies/#{@ontology.acronym}/?p=classes&t=mappings&conceptid=#{escape(@concept.id)}", :method => :get, :class => "btn btn-default mb-3"
      - else
        %div{style: 'width: 250px; margin: 0 0 10px 0;'}
          = link_to_modal(nil,
                    new_mapping_path(ontology_from: "#{@ontology.id}", conceptid_from: "#{@concept.id}"),
                    data: { show_modal_title_value: "Create a new mapping for #{@concept.prefLabel}" },
                    ) do
            = render Buttons::RegularButtonComponent.new(id:'new_mapping_btn' , value:t('mappings.create_new_mapping'), variant: 'secondary', size: 'slim', state: 'no-anim')

      #mapping_details
        = render :partial => '/mappings/mapping_table'
