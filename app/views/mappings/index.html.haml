- @title = t('mappings.index.title')
%div#mappings_container.container-fluid
  %h1.tab_header= t('mappings.index.title', default: 'Mappings')
  %p.tab_description
    = t('mappings.intro').html_safe
    = link_to(Rails.configuration.settings.links[:help_mappings],
          data: {controller: 'popup', action: 'click->popup#open'}, 'aria-label': t('mappings.index.help_aria', default: 'View mappings help')) do
      %i{class: 'fas fa-question-circle fa-lg ps-1', "aria-hidden": "true"}
  %p#mappings_select
    - if @options.empty?
      = t('mappings.index.no_mappings_available', default: 'No mappings available')
    - else
      = select('search', 'ontologies', @options, {:include_blank => ""},{:onchange=>"loadMappings(this.value);", "data-placeholder".to_sym => t('mappings.index.select_an_ontology', default: 'Select an Ontology'), autocomplete: "off"})
      #mapping_load
        %img{src: asset_path("jquery.simple.tree/spinner.gif")}/
        = t('mappings.index.loading_mappings', default: 'Loading mappings...')
      #mappingCount
