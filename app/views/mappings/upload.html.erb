<br>
<h1><%= flash[:notice] %></h1>

<%= form_tag ("/process/mapping", {:multipart => true}) do %>
		<label for="file"><%= t('mappings.upload.form.file') %>:</label> 
    <%= file_field_tag "file" %>
<br>

	<label for="user"><%= t('mappings.upload.form.user') %>:</label>
	<select name="user">
		<%=options_from_collection_for_select(@users, "id", "username", selected = nil)%>	
	</select>

<br>
	<label for="source"><%= t('mappings.upload.form.source_ontology') %>:</label>
	<select name="source">
		<%=options_from_collection_for_select(@ontologies, "displayLabel", "id", selected = nil)%>
	</select>
	<br>
	<label for="dest"><%= t('mappings.upload.form.destination_ontology') %>:</label>
	<select name="dest">
		<%=options_from_collection_for_select(@ontologies, "displayLabel", "id", selected = nil)%>
	</select>
 	<br>
	<label for="names"><%= t('mappings.upload.form.uses_names') %></label>
		<input type="checkbox" name="names" value="true">
	<br>
	<label for="source_position"><%= t('mappings.upload.form.source_position') %></label>
	<input type="text" name="source_position">
	<br>
	<label for="dest_position"><%= t('mappings.upload.form.destination_position') %></label>
	<input type="text" name="dest_position">
	<br>
	<br>
	<label for="dest_position"><%= t('mappings.upload.form.comment_position') %></label>
	<input type="text" name="comment">
	<br>
	<label for="map_source"><%= t('mappings.upload.form.map_source') %></label>
	<input type="text" name="map_source">
	<br>
	<label for="relationship"><%= t('mappings.upload.form.relationship') %></label>
	<input type="text" name="relationship">
	<br>
	<label for="delimiter"><%= t('mappings.upload.form.delimiter') %></label>
	<input type="text" name="delimiter">	
	<br>
		<%= submit_tag  t('mappings.upload.form.upload') %>
<% end %>