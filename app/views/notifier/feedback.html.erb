<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body>
    <p>
      <%= t('notifier.feedback.name') %>: <%=@name%>      
    </p>
    <p>
      <%= t('notifier.feedback.email') %>: <%=@email%>
    </p>
    <p>
      <%= t('notifier.feedback.location') %>: <%=@location%>
    </p>
    <p>
      <br /><strong><%= t('notifier.feedback.feedback') %>:</strong>
      <%=simple_format(@comment)%>
    </p>
  </body>
</html>
