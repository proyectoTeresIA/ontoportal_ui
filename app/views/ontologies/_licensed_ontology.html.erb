<div style="padding: 1em;">
  <h2><%= t('ontologies.licensed_ontology.heading') %></h2>
  <% ontology_authors = @ontology.contactName.nil? || @ontology.contactName.empty? ? "the owners" : @ontology.contactName%>
    <%if session[:user].nil?%>
      <p><%= t('ontologies.licensed_ontology.have_license_html', login_link: sanitize("<a href='/login?redirect=#{request.url}'>#{t('ontologies.licensed_ontology.log_in')}</a>")) %>.</p>
    <%else%>
      <!-- Handle when a user is logged in -->
      <script type="text/javascript">
        jQuery(document).ready(
          function(){
            jQuery("#submit_license").click(submitLicense);
          }
        );

        var submitLicense = function(e){
          if (jQuery("#ontologylicensetext").val().length < 2) {
            jQuery("#submit_license_error").html(<%=raw I18n.t('ontologies.licensed_ontology.enter_license_text').to_json %>);
            jQuery("#submit_license_error").show();
            return false;
          }
        }
      </script>
      <%= t('ontologies.licensed_ontology.instructions_html') %><br/><br/>
      <%=@ontology.licenseInformation%>

      <br/>

      <%= form_tag "/users/submit_license" do %>
        <%= hidden_field_tag :ontologylicense, @ontology.ontologyId%>
        <%= text_area_tag :ontologylicensetext, "", :rows => 7, :style => "width: 500px;"%><br/>
        <br/>
        <%= t('ontologies.licensed_ontology.contact_html', authors: ontology_authors, email: @ontology.contactEmail) %><br/>
        <br/>
        <%= submit_tag t('ontologies.licensed_ontology.submit'), :id => "submit_license" %>&nbsp;<span id="submit_license_error" style="color: red;"><%=flash[:error] unless flash[:error].nil?%></span><br/>
      <%end%>
    <%end%>
</div>

