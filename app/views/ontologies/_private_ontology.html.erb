<div style="padding: 1em; width: 500px">
  <h2><%= t('ontologies.private.title') %></h2>
  <% ontology_authors = @ontology.contactName.nil? || @ontology.contactName.empty? ? "the authors" : @ontology.contactName%>
  <p>
    <%= t('ontologies.private.body_html', authors: ontology_authors, email: @ontology.contactEmail).html_safe %>
    <% if session[:user].nil? %>
      <%= t('ontologies.private.login_prompt_html', redirect: CGI.escape(request.url)).html_safe %>
    <% end %>
  </p>
</div>
