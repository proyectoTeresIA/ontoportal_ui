= turbo_frame_tag 'widgets', data: {turbo: false} do
  - ont_uri = "/ontologies/#{@ontology.acronym}"
  - get_code_prefix = ont_uri + '?p=widgets#TB_inline&height=400&width=600'

  - if @ontology.metadata_only?
    #widgets_content{:style => "padding: 1em;"}
      %p
        = t('ontologies.widgets_page.not_available_html', site: $SITE).html_safe
  - else
    #widgets_content
      %h5.pb-3= t('ontologies.widgets_page.add_widgets_heading_html', org: $ORG, acronym: @ontology.acronym).html_safe
      %table#widget_table{width: "100%"}
        %tr
          %th
            = t('ontologies.widgets_page.headers.widget_type')
          %th
            = t('ontologies.widgets_page.headers.widget_demo')
        %tr
          %td
            %div.card
              %div.card-body
                %h5.card-title= t('ontologies.widgets_page.cards.jump_to.title')
                %p.card-text= t('ontologies.widgets_page.cards.jump_to.description', acronym: @ontology.acronym, site: $SITE)
                %a.btn.btn-info.thickbox{href: "#{get_code_prefix}&inlineId=jump".html_safe}= t('ontologies.widgets_page.get_code')
          %td
            #bp_quick_jump
            :javascript
              var BP_SEARCH_SERVER = "#{$UI_URL}";
              var BP_SITE = "#{$SITE}";
              var BP_ORG = "#{$ORG}";
              var BP_ontology_id = "#{@ontology.acronym}";
              window.BP_I18N = {
                jump_to_label: "#{j t('ontologies.widgets_page.quick_jump.jump_to_label')}",
                go_to_button: "#{j t('ontologies.widgets_page.quick_jump.go_to_button', site: $SITE)}",
                not_found_confirm: "#{j t('ontologies.widgets_page.quick_jump.not_found_confirm', site: $SITE)}",
                retrieving_definitions: "#{j t('ontologies.widgets_page.quick_jump.retrieving_definitions')}",
                synonyms_prefix: "#{j t('ontologies.widgets_page.quick_jump.synonyms_prefix')}",
                results_provided_by: "#{j t('ontologies.widgets_page.quick_jump.results_provided_by')}",
                obsolete_class_title: "#{j t('ontologies.widgets_page.quick_jump.obsolete_class_title')}"
              };
            = javascript_include_tag "/javascripts/widgets/quick_jump.js"
            #jump{:style => "display:none;"}
              %h2= t('ontologies.widgets_page.step2_heading')
              %hr/
              .enable-lists
                %ul
                  %li
                    = t('ontologies.widgets_page.instructions.download_the')
                    %a.external.free{:href => "/javascripts/widgets/quick_jump.js", :rel => "nofollow", :title => "/javascripts/widgets/quick_jump.js"}
                      %b= t('ontologies.widgets_page.instructions.quick_jump_file')
                    = t('ontologies.widgets_page.instructions.put_on_server')
                  %li
                    = t('ontologies.widgets_page.instructions.copy_code_html')
                  %li
                    %b= t('ontologies.widgets_page.instructions.note')
                    = t('ontologies.widgets_page.instructions.quick_jump_multi')
                    %ul
                      %li
                        = t('ontologies.widgets_page.instructions.multi_ids')
                        %br/
                        var BP_ontology_id = "NCIt,SNOMEDCT";
                      %li
                        = t('ontologies.widgets_page.instructions.all_ontologies', site: $SITE)
                        %br/
                        var BP_ontology_id = "all";
                  %li
                    = t('ontologies.widgets_page.instructions.include_definitions')
                    %br/
                    %pre var BP_include_definitions = true;
                  %li
                    = t('ontologies.widgets_page.instructions.change_path')
                    %ul
                      %li
                        = t('ontologies.widgets_page.instructions.example_same_dir')
                        %pre
                          = preserve do
                            :escaped
                              <div id="bp_quick_jump"></div>
                              <script type="text/javascript">
                                  var BP_ontology_id = "#{@ontology.acronym}";</script>
                              <script src="quick_jump.js" type="text/javascript" charset="utf-8"></script>
              %p
                = t('ontologies.widgets_page.instructions.more_help')
                %a{:href => "http://bioontology.org/wiki/index.php/NCBO_Widgets#How_to_use_NCBO_Widgets", :target => "_blank"} NCBO Widget Wiki
        %tr
          %td
            %div.card
              %div.card-body
                %h5.card-title= t('ontologies.widgets_page.cards.form_autocomplete.title')
                %p.card-text= t('ontologies.widgets_page.cards.form_autocomplete.description', acronym: @ontology.acronym)
                %a.btn.btn-info.thickbox{href: "#{get_code_prefix}&inlineId=form".html_safe}= t('ontologies.widgets_page.get_code')
          %td
            = javascript_include_tag "/javascripts/widgets/form_complete.js"
            = t('ontologies.widgets_page.examples.example1')
            %br/
            %input{:class => "bp_form_complete-#{CGI.escape(@ontology.acronym).sub('-', '%2d')}-uri", :name => "a", :size => "100", :type => "text"}/
            %br/
            = t('ontologies.widgets_page.examples.example2')
            %br/
            %input{:class => "bp_form_complete-#{CGI.escape(@ontology.acronym).sub('-', '%2d')}-shortid", :name => "b", :size => "100", :type => "text"}/
            %br/
            = t('ontologies.widgets_page.examples.example3')
            %br/
            %input{:class => "bp_form_complete-#{CGI.escape(@ontology.acronym).sub('-', '%2d')}-name", :name => "c", :size => "100", :type => "text"}/
            #form{:style => "display:none;"}
              .enable-lists
                %h2= t('ontologies.widgets_page.step2_heading')
                %hr/
                %ul
                  %li
                    = t('ontologies.widgets_page.instructions.download_the')
                    %a.external.free{:href => "/javascripts/widgets/form_complete.js", :rel => "nofollow", :title => "/javascripts/widgets/form_complete.js"}
                      %b = t('ontologies.widgets_page.instructions.form_complete_file')
                    = t('ontologies.widgets_page.instructions.put_on_server_period')
                  %li
                    = t('ontologies.widgets_page.instructions.include_header_form_complete_html')
                  %li
                    = t('ontologies.widgets_page.instructions.field_class_format')
                    %code bp_form_complete-{ontology_id_list}-{value}
                    %ul
                      %li
                        = t('ontologies.widgets_page.instructions.for_example')
                        %code bp_form_complete-NCIT-uri
                        = t('ontologies.widgets_page.instructions.ncit_uri_behavior')
                        %ul
                          %li
                            %b= t('ontologies.widgets_page.instructions.note')
                            = t('ontologies.widgets_page.instructions.single_or_list')
                            %br/
                            %code bp_form_complete-NCIT,NCBITAXON-uri
                          %li
                            %b= t('ontologies.widgets_page.instructions.or')
                            = t('ontologies.widgets_page.instructions.all_site_ontologies', site: $SITE)
                            %br/
                            %code bp_form_complete-all-uri
                          %li The autocomplete widget accesses ontology content from the latest version of the ontology.
                      %li
                        = t('ontologies.widgets_page.instructions.parameters_intro')
                        %ul
                          %li
                            %code uri
                            = t('ontologies.widgets_page.instructions.param_uri')
                            = succeed ")" do
                              %a.external.free{:href => @ontology.explore.classes["collection"].first.id, :rel => "nofollow", :title => "/visualize/39478/Common_Neoplasm"}
                                = @ontology.explore.classes["collection"].first.id
                          %li
                            %code shortid
                            = t('ontologies.widgets_page.instructions.param_shortid', site: $SITE)
                          %li
                            %code name
                            = t('ontologies.widgets_page.instructions.param_name')
                  %li
                    = t('ontologies.widgets_page.instructions.hidden_elements_intro')
                    %ul
                    %pre= h '<input type="text" name="a" class="bp_form_complete-all-uri" size="100"/>'
                = t('ontologies.widgets_page.instructions.name_attribute_explanation')
                %ul
                  %li
                    %pre= h '<input type="hidden" id="a_bioportal_preferred_name">'
                  %li
                    %pre= h '<input type="hidden" id="a_bioportal_concept_id">'
                  %li
                    %pre= h '<input type="hidden" id="a_bioportal_ontology_id">'
                  %li
                    %pre= h '<input type="hidden" id="a_bioportal_full_id">'
                  %li
                    = t('ontologies.widgets_page.instructions.additional_params')
                    %a{:href => "http://bioontology.org/wiki/index.php/NCBO_Widgets#How_to_use_NCBO_Widgets", :target => "_blank"} NCBO Widget Wiki
                %p
                  = t('ontologies.widgets_page.instructions.more_help')
                  %a{:href => "http://bioontology.org/wiki/index.php/NCBO_Widgets#How_to_use_NCBO_Widgets", :target => "_blank"} NCBO Widget Wiki
        %tr
          %td
            %div.card
              %div.card-body
                %h5.card-title= t('ontologies.widgets_page.cards.visualization.title')
                %p.card-text= t('ontologies.widgets_page.cards.visualization.description', acronym: @ontology.acronym)
                %a.btn.btn-info.thickbox{href: "#{get_code_prefix}&inlineId=vis".html_safe}= t('ontologies.widgets_page.get_code')
          %td
            #bp_vis_container
              <iframe frameborder="0" src="/widgets/visualization?ontology=#{@ontology.acronym}&class=#{CGI.escape(@ontology.explore.classes["collection"].first.id)}&apikey=#{$APIKEY}" width="100%" height="350"></iframe>
            #vis{:style => "display:none;"}
              %h2= t('ontologies.widgets_page.step2_heading')
              %hr/
              %b= t('ontologies.widgets_page.instructions.copy_code_html')
              %br/
              %br/
              %pre
                = preserve do
                  :escaped
                    <iframe frameborder="0" src="/widgets/visualization?ontology=#{@ontology.acronym}&class=#{CGI.escape(@ontology.explore.classes["collection"].first.id)}&apikey=YOUR_API_KEY"></iframe>
              %p
                = t('ontologies.widgets_page.instructions.more_help')
                %a{:href => "http://bioontology.org/wiki/index.php/NCBO_Widgets#How_to_use_NCBO_Widgets", :target => "_blank"} NCBO Widget Wiki

        - unless @ontology.flat?
          %tr
            %td
              %div.card
                %div.card-body
                  %h5.card-title= t('ontologies.widgets_page.cards.tree_widget.title')
                  %p.card-text= t('ontologies.widgets_page.cards.tree_widget.description', acronym: @ontology.acronym)
                  %a.btn.btn-info.thickbox{href: "#{get_code_prefix}&inlineId=widget_tree_popup".html_safe}= t('ontologies.widgets_page.get_code')
            %td
              #bp_widget_tree_container
              <link rel="stylesheet" type="text/css" href="/widgets/jquery.ncbo.tree.css">
              <div id="widget_tree"></div>
              :javascript
                 $.getScript( "/widgets/jquery.ncbo.tree-2.0.2.js", () => {
                     var widget_tree = $("#widget_tree").NCBOTree({
                                                                    apikey: "#{$API_KEY}",
                                                                    ontology: "#{@ontology.acronym}",
                                                                    ncboUIURL: "#{$UI_URL}",
                                                                    ncboAPIURL: "#{ENV['EXTERNAL_API_URL'] || LinkedData::Client.settings.rest_url}"
                                                                  });
                })

              #widget_tree_popup{:style => "display:none;"}
                %h2= t('ontologies.widgets_page.step2_heading')
                %hr/
                %b= t('ontologies.widgets_page.instructions.copy_code_html')
                %br/
                %br/
                %pre
                  = preserve do
                    :escaped
                      <link rel="stylesheet" type="text/css" href="/widgets/jquery.ncbo.tree.css">
                      <script src="/widgets/jquery.ncbo.tree-2.0.2.js"></script>
                      <div id="widget_tree"></div>
                      var widget_tree = $("#widget_tree").NCBOTree({
                        apikey: "YOUR_API_KEY",
                        ontology: "#{@ontology.acronym}"
                      });

                %p
                  = t('ontologies.widgets_page.instructions.detailed_demo_prefix')
                  %a{href: "/widgets/ncbo_tree.html"}= t('ontologies.widgets_page.instructions.detailed_demo_link')
                %p
                  = t('ontologies.widgets_page.instructions.more_help')
                  %a{:href => "http://bioontology.org/wiki/index.php/NCBO_Widgets#How_to_use_NCBO_Widgets", :target => "_blank"} NCBO Widget Wiki
