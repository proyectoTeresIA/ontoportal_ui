= render TurboFrameComponent.new(id: 'forms', data: {"turbo-frame-target": "frame"}) do
  %div.ont-ontolex-forms.ontolex-container
    %div#forms-container.container-fluid
      %div.row
        %div.col-12
          %h4= t('ontology_details.sections.forms')
          %p.text-muted Loading forms...
          %div#forms-pagination.ontolex-pagination.mt-3

  :javascript
    $(document).ready(function(){
      var currentPage = 1;
      var pageSize = 15;
      var ontologyAcronym = "#{@ontology.acronym}";
      var externalRestUrl = "#{external_rest_url}";
      var apikey = "#{get_apikey}";
      
      // Initialize the modal
      OntolexModal.init(ontologyAcronym, externalRestUrl, apikey);
      
      function loadForms(page) {
        var apiUrl = externalRestUrl + "/ontologies/" + ontologyAcronym + "/forms?page=" + page + "&pagesize=" + pageSize + "&apikey=" + apikey;
        
        $.ajax({
          url: apiUrl,
          method: 'GET',
          dataType: 'json',
          success: function(data) {
            var items = data.collection || [];
            var html = '<div class="ontolex-list-group">';
            
            if (items.length === 0) {
              html = '<div class="ontolex-empty-state"><i class="fas fa-inbox"></i><p>No forms found.</p></div>';
            } else {
              items.forEach(function(item) {
                var writtenRep = item.writtenRep || 'Unnamed';
                
                // Extract gender
                var genderBadge = '';
                if (item.gender) {
                  var genderValue = item.gender.split('#').pop() || item.gender.split('/').pop();
                  genderBadge = '<span class="ontolex-badge badge-gender">' + genderValue + '</span>';
                }
                
                // Extract number
                var numberBadge = '';
                if (item.number) {
                  var numberValue = item.number.split('#').pop() || item.number.split('/').pop();
                  numberBadge = '<span class="ontolex-badge badge-number">' + numberValue + '</span>';
                }
                
                var itemId = item['@id'] || item.id || 'Unknown';
                var signedCount = item.signedForm && Array.isArray(item.signedForm) ? item.signedForm.length : (item.signedForm ? 1 : 0);
                var videoCount = item.video && Array.isArray(item.video) ? item.video.length : (item.video ? 1 : 0);
                
                html += '<div class="entity-card" onclick="OntolexModal.loadEntity(\'forms\', \'' + itemId + '\', \'' + writtenRep + '\'); return false;" style="cursor: pointer;">';
                html += '<div class="entity-id">' + itemId + '</div>';
                html += '<div class="entity-main-text">' + writtenRep + '</div>';
                html += '<div class="entity-metadata">';
                if (genderBadge) html += genderBadge;
                if (numberBadge) html += numberBadge;
                if (signedCount > 0) { html += '<span class="ontolex-badge badge-count">Signed: ' + signedCount + '</span>'; }
                if (videoCount > 0) { html += '<span class="ontolex-badge badge-count">Video: ' + videoCount + '</span>'; }
                html += '</div>';
                html += '</div>';
              });
            }
            
            html += '</div>';
            
            // Pagination controls
            if (data.pageCount && data.pageCount > 1) {
              html += '<nav aria-label="Pagination" class="mt-3">';
              html += '<ul class="pagination justify-content-center">';
              
              // Previous button
              if (data.page > 1) {
                html += '<li class="page-item"><a class="page-link" href="#" data-page="' + (data.page - 1) + '">Previous</a></li>';
              } else {
                html += '<li class="page-item disabled"><span class="page-link">Previous</span></li>';
              }
              
              // Page numbers (show max 5 pages)
              var startPage = Math.max(1, data.page - 2);
              var endPage = Math.min(data.pageCount, startPage + 4);
              startPage = Math.max(1, endPage - 4);
              
              for (var i = startPage; i <= endPage; i++) {
                if (i === data.page) {
                  html += '<li class="page-item active"><span class="page-link">' + i + '</span></li>';
                } else {
                  html += '<li class="page-item"><a class="page-link" href="#" data-page="' + i + '">' + i + '</a></li>';
                }
              }
              
              // Next button
              if (data.page < data.pageCount) {
                html += '<li class="page-item"><a class="page-link" href="#" data-page="' + (data.page + 1) + '">Next</a></li>';
              } else {
                html += '<li class="page-item disabled"><span class="page-link">Next</span></li>';
              }
              
              html += '</ul>';
              html += '<p class="text-center text-muted">Page ' + data.page + ' of ' + data.pageCount + '</p>';
              html += '</nav>';
            }
            
            $('#forms-container').html(html);
            
            // Attach click handlers to pagination links
            $('#forms-container .pagination a').on('click', function(e) {
              e.preventDefault();
              var page = $(this).data('page');
              loadForms(page);
            });
          },
          error: function(xhr, status, error) {
            $('#forms-container').html('<div class="alert alert-danger">Error loading forms: ' + error + '</div>');
          }
        });
      }
      
      loadForms(currentPage);
    });
