= render TurboFrameComponent.new(id: 'lexical_concepts', data: {"turbo-frame-target": "frame"}) do
  %div.ont-ontolex-lexical-concepts.ontolex-container
    %div#lexical-concepts-container.container-fluid
      %div.row
        %div.col-12
          %h4= t('ontology_details.sections.lexical_concepts')
          %p.text-muted Loading lexical concepts...
          %div#lexical-concepts-pagination.ontolex-pagination.mt-3
  
  :javascript
    $(document).ready(function() {
      var currentPage = 1;
      var pageSize = 15;
      var externalRestUrl = "#{external_rest_url}";
      var apikey = "#{get_apikey}";
      var ontologyAcronym = "#{@ontology.acronym}";
      
      // Initialize the modal
      OntolexModal.init(ontologyAcronym, externalRestUrl, apikey);

      function loadLexicalConcepts(page) {
        var apiUrl = externalRestUrl + "/ontologies/" + ontologyAcronym + "/lexical_concepts?page=" + page + "&pagesize=" + pageSize + "&apikey=" + apikey;
        
        $.ajax({
          url: apiUrl,
          method: 'GET',
          dataType: 'json',
          success: function(data) {
            var items = data.collection || [];
            var html = '<div class="ontolex-list-group">';
            
            if (items.length === 0) {
              html += '<div class="ontolex-empty-state"><i class="fas fa-inbox"></i><p>No lexical concepts found.</p></div>';
            } else {
              items.forEach(function(item) {
                var itemId = item['@id'] || item.id || 'Unknown';
                var definition = 'No definition available';
                
                if (item.definition && Array.isArray(item.definition) && item.definition.length > 0) {
                  if (item.definition[0].value) {
                    definition = item.definition[0].value;
                  } else if (item.definition[0].label) {
                    definition = item.definition[0].label;
                  } else if (typeof item.definition[0] === 'string') {
                    definition = item.definition[0];
                  }
                }
                
                var subject = item.subject && item.subject.prefLabel ? item.subject.prefLabel : null;
                var notesCount = item.note && Array.isArray(item.note) ? item.note.length : (item.note ? 1 : 0);
                var evokedCount = item.isEvokedBy && Array.isArray(item.isEvokedBy) ? item.isEvokedBy.length : (item.isEvokedBy ? 1 : 0);
                var sensesCount = item.lexicalizedSense && Array.isArray(item.lexicalizedSense) ? item.lexicalizedSense.length : (item.lexicalizedSense ? 1 : 0);
                var shortId = itemId.split('/').pop();
                
                html += '<div class="entity-card" onclick="OntolexModal.loadEntity(\'lexical_concepts\', \'' + itemId + '\', \'' + shortId + '\'); return false;" style="cursor: pointer;">';
                html += '<div class="entity-id">' + itemId + '</div>';
                html += '<div class="entity-main-text">' + shortId + '</div>';
                html += '<p class="mb-2 text-muted small">' + definition + '</p>';
                html += '<div class="entity-metadata">';
                if (subject) { html += '<span class="ontolex-badge badge-subject">' + subject + '</span>'; }
                if (notesCount > 0) { html += '<span class="ontolex-badge badge-count">Notes: ' + notesCount + '</span>'; }
                if (evokedCount > 0) { html += '<span class="ontolex-badge badge-count">Evoked: ' + evokedCount + '</span>'; }
                if (sensesCount > 0) { html += '<span class="ontolex-badge badge-count">Senses: ' + sensesCount + '</span>'; }
                html += '</div>';
                html += '</div>';
              });
              html += '</div>';
            }
            
            // Pagination controls
            if (data.pageCount && data.pageCount > 1) {
              html += '<nav aria-label="Pagination" class="mt-3">';
              html += '<ul class="pagination justify-content-center">';
              
              // Previous button
              if (data.page > 1) {
                html += '<li class="page-item"><a class="page-link" href="#" data-page="' + (data.page - 1) + '">Previous</a></li>';
              } else {
                html += '<li class="page-item disabled"><span class="page-link">Previous</span></li>';
              }
              
              // Page numbers (show max 5 pages)
              var startPage = Math.max(1, data.page - 2);
              var endPage = Math.min(data.pageCount, startPage + 4);
              startPage = Math.max(1, endPage - 4);
              
              for (var i = startPage; i <= endPage; i++) {
                if (i === data.page) {
                  html += '<li class="page-item active"><span class="page-link">' + i + '</span></li>';
                } else {
                  html += '<li class="page-item"><a class="page-link" href="#" data-page="' + i + '">' + i + '</a></li>';
                }
              }
              
              // Next button
              if (data.page < data.pageCount) {
                html += '<li class="page-item"><a class="page-link" href="#" data-page="' + (data.page + 1) + '">Next</a></li>';
              } else {
                html += '<li class="page-item disabled"><span class="page-link">Next</span></li>';
              }
              
              html += '</ul>';
              html += '<p class="text-center text-muted">Page ' + data.page + ' of ' + data.pageCount + '</p>';
              html += '</nav>';
            }
            
            $('#lexical-concepts-container').html(html);
            
            // Attach click handlers to pagination links
            $('#lexical-concepts-container .pagination a').on('click', function(e) {
              e.preventDefault();
              var page = $(this).data('page');
              loadLexicalConcepts(page);
            });
          },
          error: function(xhr, status, error) {
            $('#lexical-concepts-container').html('<div class="alert alert-danger">Error loading lexical concepts: ' + error + '</div>');
          }
        });
      }

      // Initial load
      loadLexicalConcepts(currentPage);
      
      // Check if there's a conceptid parameter in the URL to open the modal automatically
      var urlParams = new URLSearchParams(window.location.search);
      var conceptId = urlParams.get('conceptid');
      if (conceptId) {
        // Decode the concept ID if it's URL encoded
        conceptId = decodeURIComponent(conceptId);
        var shortId = conceptId.split('/').pop();
        // Open the modal after a brief delay to ensure everything is initialized
        setTimeout(function() {
          OntolexModal.loadEntity('lexical_concepts', conceptId, shortId);
        }, 500);
      }
    });
