= render TurboFrameComponent.new(id: 'lexical_concepts', data: {"turbo-frame-target": "frame"}) do
  %div.tooltip
  %div#bd_content.bd_content.explore.py-3{data:{controller: 'container-splitter'}}
    %div.sidebar.d-flex.flex-column.p-1.mx-2{data:{'container-splitter-target': 'container'}}
      %div#lexical-concepts-list.ontolex-list-sidebar
        .text-center.py-3
          %span.spinner-border.spinner-border-sm{role: "status"}
    %div#lexical_concept_content.d-flex.flex-column{data:{'container-splitter-target': 'container'}}
      = render partial: 'lexical_concepts/show'

  = javascript_include_tag 'ontolex_renderer', defer: true
  = javascript_include_tag 'ontolex_sidebar', defer: true
  :javascript
    (function() {
      var externalRestUrl = "#{external_rest_url}";
      var apikey = "#{get_apikey}";
      var ontologyAcronym = "#{@ontology.acronym}";
      var baseURL = "#{Rails.application.config.relative_url_root}";
      var isInitialized = false;
      var sidebar = null;

      // Set global translations object (persists across Turbo Frame loads)
      if (!window.ONTOLEX_TRANSLATIONS) {
        window.ONTOLEX_TRANSLATIONS = #{ontolex_translations_json};
      }
      
      // Custom item renderer for lexical concepts
      function uriToString(value) {
        if (!value) return '';
        if (typeof value === 'string') return value;
        if (typeof value === 'object') {
          return value.uri || value['@id'] || value.id || '';
        }
        return String(value);
      }

      function renderLexicalConceptItem(item) {
        var itemId = uriToString(item['@id'] || item.id) || 'Unknown';
        var shortId = itemId.split('/').pop();
        var definition = 'No definition';
        
        if (item.definition && Array.isArray(item.definition) && item.definition.length > 0) {
          if (item.definition[0].value) {
            definition = item.definition[0].value;
          } else if (item.definition[0].label) {
            definition = item.definition[0].label;
          } else if (typeof item.definition[0] === 'string') {
            definition = item.definition[0];
          }
        }
        
        // Truncate definition
        if (definition.length > 60) {
          definition = definition.substring(0, 60) + '...';
        }
        
        var html = '<div>' + shortId + '</div>';
        html += '<div class="text-muted small">' + definition + '</div>';
        
        return html;
      }

      function loadLexicalConceptDetails(conceptId) {
        $('#lexical-concept-details-container').html('<div class="text-center py-5"><span class="spinner-border spinner-border-sm"></span></div>');
        
        var apiUrl = externalRestUrl + "/ontologies/" + ontologyAcronym + "/lexical_concepts/" + encodeURIComponent(conceptId) + "?apikey=" + apikey;
        var mappingsUrl = externalRestUrl + "/ontologies/" + ontologyAcronym + "/lexical_concepts/" + encodeURIComponent(conceptId) + "/mappings?apikey=" + apikey + "&pagesize=500";

        $.ajax({
          url: apiUrl,
          method: 'GET',
          dataType: 'json',
          success: function(data) {
            // Fetch SKOS cross-ontology mappings to resolve target ontologies for links
            $.ajax({
              url: mappingsUrl,
              method: 'GET',
              dataType: 'json',
              success: function(mappingsData) {
                var crossOntologyMap = buildCrossOntologyMap(mappingsData);
                var html = renderLexicalConceptDetails(data, crossOntologyMap);
                $('#lexical-concept-details-container').html(html);
              },
              error: function() {
                // Render without cross-ontology resolution on mappings failure
                var html = renderLexicalConceptDetails(data, {});
                $('#lexical-concept-details-container').html(html);
              }
            });
          },
          error: function(xhr, status, error) {
            $('#lexical-concept-details-container').html('<div class="alert alert-danger m-3">Error loading details: ' + error + '</div>');
          }
        });
      }

      // Build a map from concept URI to target ontology acronym from a mappings API response
      function buildCrossOntologyMap(mappingsData) {
        var map = {};
        if (!mappingsData || !mappingsData.collection) return map;
        mappingsData.collection.forEach(function(mapping) {
          var classes = mapping.classes;
          if (!classes || classes.length < 2) return;
          var targetClass = classes[1];
          if (!targetClass) return;
          // Normalize @id: may be a plain string or an object with .uri
          var idVal = targetClass['@id'] || targetClass.id;
          var targetUri = (typeof idVal === 'string') ? idVal : (idVal && (idVal.uri || idVal['@id']));
          if (!targetUri || typeof targetUri !== 'string') return;
          // Extract ontology acronym from links.ontology, then fall back to links.self
          var targetAcronym = null;
          var ontLink = targetClass.links && (targetClass.links.ontology || targetClass.links['ontology']);
          if (ontLink && typeof ontLink === 'string') {
            targetAcronym = ontLink.split('/').pop();
          }
          if (!targetAcronym) {
            var selfLink = targetClass.links && (targetClass.links.self || targetClass.links['self']);
            if (selfLink && typeof selfLink === 'string') {
              // Format: "ontologies/ACRONYM/lexical_concepts/..." or full URL
              var parts = selfLink.split('/');
              var ontIdx = parts.lastIndexOf('ontologies');
              if (ontIdx >= 0 && parts[ontIdx + 1]) {
                targetAcronym = parts[ontIdx + 1];
              }
            }
          }
          if (targetAcronym && targetAcronym !== ontologyAcronym) {
            map[targetUri] = targetAcronym;
          }
        });
        return map;
      }

      function renderLexicalConceptDetails(data, crossOntologyMap) {
        var html = '<div class="ontolex-details p-3">';
        var conceptId = uriToString(data['@id'] || data.id);
        html += '<h6 class="border-bottom pb-2 mb-3">' + 
        conceptId.split('/').pop() +
        '</h6>';
        
        // Auto-render all fields using shared renderer
        if (window.OntolexRenderer) {
          html += OntolexRenderer.renderAllFields(data, ontologyAcronym, baseURL, { crossOntologyMap: crossOntologyMap || {} });
        }
        
        html += '</div>';
        return html;
      }

      // Initial load
      function initialize() {
        if (isInitialized) return;
        
        // Wait for OntolexSidebar to be loaded
        if (typeof window.OntolexSidebar === 'undefined') {
          setTimeout(initialize, 50);
          return;
        }
        
        isInitialized = true;
        
        // Check if there's an id parameter in the URL
        var urlParams = new URLSearchParams(window.location.search);
        var currentSection = urlParams.get('p');
        var conceptId = urlParams.get('id');
        var hasIdParam = conceptId && currentSection === 'lexical_concepts';
        
        // Create sidebar instance
        sidebar = window.OntolexSidebar.create({
          containerId: 'lexical-concepts-list',
          entityType: 'lexical_concepts',
          ontologyAcronym: ontologyAcronym,
          externalRestUrl: externalRestUrl,
          apikey: apikey,
          pageSize: 50,
          renderItem: renderLexicalConceptItem,
          onItemSelect: loadLexicalConceptDetails,
          noItemsMessage: "#{t('ontology_details.ontolex.no_items_found')}",
          skipAutoSelect: hasIdParam  // Skip auto-select if we have an id in URL
        });
        
        // Load first page (or find specific item if id provided)
        if (hasIdParam) {
          sidebar.findAndSelectItem(conceptId);
        } else {
          sidebar.loadPage(1);
        }
      }
      
      // Initialize when the document is ready
      $(document).ready(function() {
        initialize();
      });
      
      // Re-initialize when this frame becomes visible (Turbo Frame load event)
      document.addEventListener('turbo:frame-load', function(event) {
        if (event.target.id === 'lexical_concepts') {
          var urlParams = new URLSearchParams(window.location.search);
          var currentSection = urlParams.get('p');
          
          // Only initialize if we're on the lexical_concepts section
          if (currentSection === 'lexical_concepts') {
            initialize();
          }
        }
      });
    })();
