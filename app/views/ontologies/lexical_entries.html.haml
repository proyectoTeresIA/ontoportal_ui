= render TurboFrameComponent.new(id: 'lexical_entries', data: {"turbo-frame-target": "frame"}) do
  %div.tooltip
  %div#bd_content.bd_content.explore.py-3{data:{controller: 'container-splitter'}}
    %div.sidebar.d-flex.flex-column.p-1.mx-2{data:{'container-splitter-target': 'container'}}
      %div#lexical-entries-list.ontolex-list-sidebar
        .text-center.py-3
          %span.spinner-border.spinner-border-sm{role: "status"}
    %div#lexical_entry_content.d-flex.flex-column{data:{'container-splitter-target': 'container'}}
      = render partial: 'lexical_entries/show'

  = javascript_include_tag 'ontolex_renderer', defer: true
  = javascript_include_tag 'ontolex_sidebar', defer: true
  :javascript
    (function() {
      var ontologyAcronym = "#{@ontology.acronym}";
      var externalRestUrl = "#{external_rest_url}";
      var baseURL = "#{Rails.application.config.relative_url_root}";
      var apikey = "#{get_apikey}";
      var isInitialized = false;
      var sidebar = null;

      // Set global translations object (persists across Turbo Frame loads)
      if (!window.ONTOLEX_TRANSLATIONS) {
        window.ONTOLEX_TRANSLATIONS = #{ontolex_translations_json};
      }
      
      // Custom item renderer for lexical entries
      function renderLexicalEntryItem(item) {
        var itemId = item['@id'] || item.id || 'Unknown';
        var lemma = item.lemma || itemId.split('/').pop();
        
        var html = '<div>' + lemma + '</div>';
        
        if (item.language) {
          var langCode = item.language.split('/').pop();
          html += '<span class="ontolex-badge badge-language">' + langCode + '</span>';
        }
        
        return html;
      }
      
      function loadLexicalEntryDetails(entryId) {
        $('#lexical-entry-details-container').html('<div class="text-center py-5"><span class="spinner-border spinner-border-sm"></span></div>');
        
        var apiUrl = externalRestUrl + "/ontologies/" + ontologyAcronym + "/lexical_entries/" + encodeURIComponent(entryId) + "?apikey=" + apikey;
        
        $.ajax({
          url: apiUrl,
          method: 'GET',
          dataType: 'json',
          success: function(data) {
            var html = renderLexicalEntryDetails(data);
            $('#lexical-entry-details-container').html(html);
          },
          error: function(xhr, status, error) {
            $('#lexical-entry-details-container').html('<div class="alert alert-danger m-3">Error: ' + error + '</div>');
          }
        });
      }
      
      function renderLexicalEntryDetails(data) {
        var html = '<div class="ontolex-details p-3">';
        html += '<h6 class="border-bottom pb-2 mb-3">' + 
        data['@id'].split('/').pop() +
        '</h6>';
        
        // Auto-render all fields using shared renderer
        if (window.OntolexRenderer) {
          html += OntolexRenderer.renderAllFields(data, ontologyAcronym, baseURL);
        }
        
        html += '</div>';
        return html;
      }
      
      // Initial load
      function initialize() {
        if (isInitialized) return;
        
        // Wait for OntolexSidebar to be loaded
        if (typeof window.OntolexSidebar === 'undefined') {
          setTimeout(initialize, 50);
          return;
        }
        
        isInitialized = true;
        
        // Check if there's an id parameter in the URL
        var urlParams = new URLSearchParams(window.location.search);
        var currentSection = urlParams.get('p');
        var entryId = urlParams.get('id');
        var hasIdParam = entryId && currentSection === 'lexical_entries';
        
        // Create sidebar instance
        sidebar = window.OntolexSidebar.create({
          containerId: 'lexical-entries-list',
          entityType: 'lexical_entries',
          ontologyAcronym: ontologyAcronym,
          externalRestUrl: externalRestUrl,
          apikey: apikey,
          pageSize: 50,
          renderItem: renderLexicalEntryItem,
          onItemSelect: loadLexicalEntryDetails,
          noItemsMessage: "#{t('ontology_details.ontolex.no_items_found')}",
          skipAutoSelect: hasIdParam  // Skip auto-select if we have an id in URL
        });
        
        // Load first page (or find specific item if id provided)
        if (hasIdParam) {
          entryId = decodeURIComponent(entryId);
          sidebar.findAndSelectItem(entryId);
        } else {
          sidebar.loadPage(1);
        }
      }
      
      // Initialize when the document is ready
      $(document).ready(function() {
        initialize();
      });
      
      // Re-initialize when this frame becomes visible (Turbo Frame load event)
      document.addEventListener('turbo:frame-load', function(event) {
        if (event.target.id === 'lexical_entries') {
          var urlParams = new URLSearchParams(window.location.search);
          var currentSection = urlParams.get('p');
          
          // Only initialize if we're on the lexical_entries section
          if (currentSection === 'lexical_entries') {
            initialize();
          }
        }
      });
    })();
