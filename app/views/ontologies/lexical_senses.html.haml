= render TurboFrameComponent.new(id: 'lexical_senses', data: {"turbo-frame-target": "frame"}) do
  %div.ont-ontolex-lexical-senses.py-3
    %div#lexical-senses-container.container-fluid
      %div.row
        %div.col-12
          %h4= t('ontology_details.sections.lexical_senses')
          %p.text-muted Loading lexical senses...

  :javascript
    $(document).ready(function(){
      var currentPage = 1;
      var ontologyAcronym = "#{@ontology.acronym}";
      var externalRestUrl = "#{external_rest_url}";
      var apikey = "#{get_apikey}";
      
      // Initialize the modal
      OntolexModal.init(ontologyAcronym, externalRestUrl, apikey);
      
      function loadLexicalSenses(page) {
        var apiUrl = externalRestUrl + "/ontologies/" + ontologyAcronym + "/lexical_senses?page=" + page + "&apikey=" + apikey;
        
        $.ajax({
          url: apiUrl,
          method: 'GET',
          dataType: 'json',
          success: function(data) {
            var items = data.collection || [];
            var html = '<div class="list-group">';
            
            if (items.length === 0) {
              html += '<div class="alert alert-info">No lexical senses found.</div>';
            } else {
              items.forEach(function(item) {
                var definition = item.definition || '';
                var reference = item.reference || '';
                var example = item.example || '';
                
                // Count synonyms and translations
                var synonymCount = item.synonym ? (Array.isArray(item.synonym) ? item.synonym.length : 1) : 0;
                var translationCount = item.translation ? (Array.isArray(item.translation) ? item.translation.length : 1) : 0;
                
                var itemId = item['@id'] || item.id || 'Unknown';
                var shortId = itemId.split('/').pop();
                var displayText = definition || reference || shortId;
                
                html += '<a href="#" class="list-group-item list-group-item-action" onclick="OntolexModal.loadEntity(\'lexical_senses\', \'' + itemId + '\', \'' + shortId + '\'); return false;">';
                html += '<div class="d-flex w-100 justify-content-between">';
                html += '<div>';
                if (synonymCount > 0) {
                  html += '<span class="badge bg-info me-1">' + synonymCount + ' synonym' + (synonymCount > 1 ? 's' : '') + '</span>';
                }
                if (translationCount > 0) {
                  html += '<span class="badge bg-success">' + translationCount + ' translation' + (translationCount > 1 ? 's' : '') + '</span>';
                }
                html += '</div>';
                html += '</div>';
                
                if (definition) {
                  html += '<p class="mb-1"><strong>Definition:</strong> ' + definition + '</p>';
                }
                if (reference) {
                  html += '<p class="mb-1"><strong>Reference:</strong> ' + reference + '</p>';
                }
                if (example) {
                  html += '<p class="mb-1"><strong>Example:</strong> ' + example + '</p>';
                }
                
                html += '<small class="text-muted">ID: ' + itemId + '</small>';
                html += '</a>';
              });
            }
            
            html += '</div>';
            
            // Pagination controls
            if (data.pageCount && data.pageCount > 1) {
              html += '<nav aria-label="Pagination" class="mt-3">';
              html += '<ul class="pagination justify-content-center">';
              
              // Previous button
              if (data.page > 1) {
                html += '<li class="page-item"><a class="page-link" href="#" data-page="' + (data.page - 1) + '">Previous</a></li>';
              } else {
                html += '<li class="page-item disabled"><span class="page-link">Previous</span></li>';
              }
              
              // Page numbers (show max 5 pages)
              var startPage = Math.max(1, data.page - 2);
              var endPage = Math.min(data.pageCount, startPage + 4);
              startPage = Math.max(1, endPage - 4);
              
              for (var i = startPage; i <= endPage; i++) {
                if (i === data.page) {
                  html += '<li class="page-item active"><span class="page-link">' + i + '</span></li>';
                } else {
                  html += '<li class="page-item"><a class="page-link" href="#" data-page="' + i + '">' + i + '</a></li>';
                }
              }
              
              // Next button
              if (data.page < data.pageCount) {
                html += '<li class="page-item"><a class="page-link" href="#" data-page="' + (data.page + 1) + '">Next</a></li>';
              } else {
                html += '<li class="page-item disabled"><span class="page-link">Next</span></li>';
              }
              
              html += '</ul>';
              html += '<p class="text-center text-muted">Page ' + data.page + ' of ' + data.pageCount + '</p>';
              html += '</nav>';
            }
            
            $('#lexical-senses-container').html(html);
            
            // Attach click handlers to pagination links
            $('#lexical-senses-container .pagination a').on('click', function(e) {
              e.preventDefault();
              var page = $(this).data('page');
              loadLexicalSenses(page);
            });
          },
          error: function(xhr, status, error) {
            $('#lexical-senses-container').html('<div class="alert alert-danger">Error loading lexical senses: ' + error + '</div>');
          }
        });
      }
      
      loadLexicalSenses(currentPage);
    });
