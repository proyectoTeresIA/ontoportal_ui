= render TurboFrameComponent.new(id: 'lexical_senses', data: {"turbo-frame-target": "frame"}) do
  %div.ont-ontolex-lexical-senses.ontolex-container
    %div#lexical-senses-container.container-fluid
      %div.row
        %div.col-12
          %h4= t('ontology_details.sections.lexical_senses')
          %p.text-muted Loading lexical senses...
          %div#lexical-senses-pagination.ontolex-pagination.mt-3

  :javascript
    $(document).ready(function(){
      var currentPage = 1;
      var pageSize = 15;
      var ontologyAcronym = "#{@ontology.acronym}";
      var externalRestUrl = "#{external_rest_url}";
      var apikey = "#{get_apikey}";
      
      // Initialize the modal
      OntolexModal.init(ontologyAcronym, externalRestUrl, apikey);
      
      function loadLexicalSenses(page) {
        var apiUrl = externalRestUrl + "/ontologies/" + ontologyAcronym + "/lexical_senses?page=" + page + "&pagesize=" + pageSize + "&apikey=" + apikey;
        
        $.ajax({
          url: apiUrl,
          method: 'GET',
          dataType: 'json',
          success: function(data) {
            var items = data.collection || [];
            var html = '<div class="ontolex-list-group">';
            
            if (items.length === 0) {
              html = '<div class="ontolex-empty-state"><i class="fas fa-inbox"></i><p>No lexical senses found.</p></div>';
            } else {
              items.forEach(function(item) {
                var definition = item.definition || '';
                var reference = item.reference || '';
                var example = item.example || '';
                
                // Count synonyms and translations
                var synonymCount = item.synonym ? (Array.isArray(item.synonym) ? item.synonym.length : 1) : 0;
                var translationCount = item.translation ? (Array.isArray(item.translation) ? item.translation.length : 1) : 0;
                var usageExampleCount = item.usageExample ? (Array.isArray(item.usageExample) ? item.usageExample.length : 1) : 0;
                var usageCount = item.usage ? (Array.isArray(item.usage) ? item.usage.length : 1) : 0;
                
                var itemId = item['@id'] || item.id || 'Unknown';
                var shortId = itemId.split('/').pop();
                var displayText = definition || reference || shortId;
                
                html += '<div class="entity-card" onclick="OntolexModal.loadEntity(\'lexical_senses\', \'' + itemId + '\', \'' + shortId + '\'); return false;" style="cursor: pointer;">';
                html += '<div class="entity-id">' + itemId + '</div>';
                html += '<div class="entity-main-text">' + shortId + '</div>';
                
                if (definition) {
                  html += '<p class="mb-2 text-muted small">' + definition + '</p>';
                } else if (example) {
                  html += '<p class="mb-2 text-muted small fst-italic">' + example + '</p>';
                }
                
                html += '<div class="entity-metadata">';
                if (synonymCount > 0) {
                  html += '<span class="ontolex-badge badge-count">Synonyms: ' + synonymCount + '</span>';
                }
                if (translationCount > 0) {
                  html += '<span class="ontolex-badge badge-count">Translations: ' + translationCount + '</span>';
                }
                if (usageExampleCount > 0) { html += '<span class="ontolex-badge badge-count">Examples: ' + usageExampleCount + '</span>'; }
                if (usageCount > 0) { html += '<span class="ontolex-badge badge-count">Usages: ' + usageCount + '</span>'; }
                if (item.termType) { 
                  var termType = item.termType.split('#').pop() || item.termType.split('/').pop();
                  html += '<span class="ontolex-badge badge-termtype">' + termType + '</span>'; 
                }
                if (item.normativeAuthorization) {
                  var normAuth = item.normativeAuthorization.split('#').pop() || item.normativeAuthorization.split('/').pop();
                  html += '<span class="ontolex-badge badge-auth">' + normAuth + '</span>';
                }
                if (item.reliabilityCode) {
                  var relCode = item.reliabilityCode.split('#').pop() || item.reliabilityCode.split('/').pop();
                  html += '<span class="ontolex-badge badge-reliability">' + relCode + '</span>';
                }
                html += '</div>';
                html += '</div>';
              });
            }
            
            html += '</div>';
            
            // Pagination controls
            if (data.pageCount && data.pageCount > 1) {
              html += '<nav aria-label="Pagination" class="mt-3">';
              html += '<ul class="pagination justify-content-center">';
              
              // Previous button
              if (data.page > 1) {
                html += '<li class="page-item"><a class="page-link" href="#" data-page="' + (data.page - 1) + '">Previous</a></li>';
              } else {
                html += '<li class="page-item disabled"><span class="page-link">Previous</span></li>';
              }
              
              // Page numbers (show max 5 pages)
              var startPage = Math.max(1, data.page - 2);
              var endPage = Math.min(data.pageCount, startPage + 4);
              startPage = Math.max(1, endPage - 4);
              
              for (var i = startPage; i <= endPage; i++) {
                if (i === data.page) {
                  html += '<li class="page-item active"><span class="page-link">' + i + '</span></li>';
                } else {
                  html += '<li class="page-item"><a class="page-link" href="#" data-page="' + i + '">' + i + '</a></li>';
                }
              }
              
              // Next button
              if (data.page < data.pageCount) {
                html += '<li class="page-item"><a class="page-link" href="#" data-page="' + (data.page + 1) + '">Next</a></li>';
              } else {
                html += '<li class="page-item disabled"><span class="page-link">Next</span></li>';
              }
              
              html += '</ul>';
              html += '<p class="text-center text-muted">Page ' + data.page + ' of ' + data.pageCount + '</p>';
              html += '</nav>';
            }
            
            $('#lexical-senses-container').html(html);
            
            // Attach click handlers to pagination links
            $('#lexical-senses-container .pagination a').on('click', function(e) {
              e.preventDefault();
              var page = $(this).data('page');
              loadLexicalSenses(page);
            });
          },
          error: function(xhr, status, error) {
            $('#lexical-senses-container').html('<div class="alert alert-danger">Error loading lexical senses: ' + error + '</div>');
          }
        });
      }
      
      loadLexicalSenses(currentPage);
    });
