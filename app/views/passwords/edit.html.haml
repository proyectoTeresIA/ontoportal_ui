%div.container
  %div.edit-user-info
    = form_with url: password_path, method: 'patch', class: 'my-4' do |f|
      - if @errors.present?
        %div{class: 'alert alert-danger mb-4'}
          - for error in @errors
            %div= error
      %h2{class: 'pb-2 border-bottom'}= t('passwords.edit.heading')
      = tag.p t('passwords.edit.instructions', site: $SITE, username: @user.username), class: 'text-muted mb-4'
      %div.mb-3
        = f.label :password, t('passwords.edit.new_password'), class: 'form-label'
        = f.password_field :password, class: 'form-control', required: 'true'
      %div.mb-4
        = f.label :password_confirmation, t('passwords.edit.confirm_password'), class: 'form-label'
        = f.password_field :password_confirmation, class: 'form-control', required: 'true'
      %div
        = submit_tag(t('passwords.edit.update_button'), class: 'btn btn-primary me-1')
        = link_to t('components.cancel_button'), user_path(@user.username), class: 'btn btn-primary'
