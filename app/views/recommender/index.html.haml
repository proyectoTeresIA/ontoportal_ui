- @title = t('recommender.index.title', default: 'Recommender')

%h2.mt-4= t('recommender.index.heading', default: 'Ontology Recommender')
%p
  = t('recommender.intro').html_safe
  = link_to(Rails.configuration.settings.links[:help_recommender],
            data: {controller: 'popup', action: 'click->popup#open'},
            'aria-label': t('recommender.index.help_aria', default: 'View ontology recommender help')) do
    %i{class: 'fas fa-question-circle fa-lg ps-1', "aria-hidden": "true"}

%form
  -# Specify input format
  %div.mb-3
    %h5= t('recommender.index.input_section', default: 'Input')
    %div.form-check.form-check-inline
      %input#radioItText.form-check-input{name: "input_type", type: "radio", value: "1", checked: "checked"}
      %label.form-check-label{for: "radioItText"}= t('recommender.index.input_text_label', default: 'Text')
    %div.form-check.form-check-inline
      %input#radioItKeywords.form-check-input{name: "input_type", type: "radio", value: "2"}
      %label.form-check-label{for: "radioItKeywords"}= t('recommender.index.input_keywords_label', default: 'Keywords (separated by commas)')
  
  -# Input text or keywords
  %div.mb-3
    = text_area_tag("inputText", nil, rows: 10, class: "form-control default", placeholder: t('recommender.index.textarea_placeholder'), aria: {describedby: "inputTextHelpBlock"})
    %div.card#inputTextHighlighted
      %div.card-body
    %div#inputTextHelpBlock.form-text
      %a#insertInputLink{href: "javascript:void(0);"}= t('recommender.index.insert_sample_input')

  %div.mb-3
    %a#advancedOptionsLink{:href => "javascript:void(0);"}= t('recommender.index.show_advanced')

  -# Advanced options
  %div#advancedOptions
    -# Specify weights
    %h6= t('recommender.index.weights_configuration')
    %div.row.mb-3
      %div.col-md-2
        %label{for: "input_wc"}= t('recommender.index.coverage_label')
        = number_field_tag("input_wc", "0.55", min: "0", step: "1", class: "form-control")
      %div.col-md-2
        %label{for: "input_wa"}= t('recommender.index.acceptance_label')
        = number_field_tag("input_wa", "0.15", min: "0", step: "1", class: "form-control")
      %div.col-md-2
        %label{for: "input_wd"}= t('recommender.index.knowledge_detail_label')
        = number_field_tag("input_wd", "0.15", min: "0", step: "1", class: "form-control")
      %div.col-md-2
        %label{for: "input_ws"}= t('recommender.index.specialization_label')
        = number_field_tag("input_ws", "0.15", min: "0", step: "1", class: "form-control")
    -# Hidden defaults for simplified UI
    = hidden_field_tag("output_type", "1")

  %div.my-4
    = submit_tag(t('recommender.index.get_recommendations'), id: "recommenderButton", type: "button", class: "btn btn-primary")
    = submit_tag(t('recommender.index.edit_input'), id: "editButton", type: "button", style: "display: none;", class: "btn btn-primary")
    = content_tag(:span, class: "recommenderSpinner", style: "display: none;") do
      %span.spinner-border.spinner-border-sm.ms-1{role: "status", 'aria-hidden': "true"}

%div.row#recommenderErrorsDisplay.mb-4
  %div.col
    %span.notTextError
      = t('recommender.index.errors.not_text')
      %br/
    %span.sumWeightsError
      = t('recommender.index.errors.sum_weights')
      %br/
    %span.rangeWeightsError
      = t('recommender.index.errors.range_weights')
      %br/
    %span.invalidWeightsError
      = t('recommender.index.errors.invalid_weights')
      %br/
    %span.invalidMaxOntError
      = t('recommender.index.errors.invalid_max_ont')
      %br/
    %span.maxOntologiesError
      = t('recommender.index.errors.max_ontologies')
      %br/
    %span.generalError
      = t('recommender.index.errors.general')
      %br/
    %span#noResults
      = t('recommender.index.errors.no_results')
      %br/
    %span#noResultsSets
      = t('recommender.index.errors.no_results_sets')
      %br/
    %span.inputSizeError
      = t('recommender.index.errors.input_size')

%div.row#resultsDisplay
  %div.col
    %h5#resultsHeader
    %div#recommender-results.mb-5
