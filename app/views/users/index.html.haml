%table.zebra{:cellpadding => "0", :cellspacing => "0"}
  %tr
    %th= t('users.index.headers.first_name')
    %th= t('users.index.headers.last_name')
    %th= t('users.index.headers.username')
    %th= t('users.index.headers.email')
    %th= t('users.index.headers.roles')
    %th= t('users.index.headers.id')
    %th= t('users.index.headers.actions')
  - for user in @users
    %tr{:class => cycle("odd", "even")}
      %td= user.firstName
      %td= user.lastName
      %td= user.username
      %td= user.email
      %td= user.role.join(" | ")
      %td= user.id
      %td= t('users.index.actions.view_edit_delete')
